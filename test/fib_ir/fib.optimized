(LetRec fib.12:(Int -> Int) n.13:Int =
  (Let Ti1.18:Int =
    1
  In
  (If (LE n.13 Ti1.18) Then
    n.13
  Else
    (Let Ti3.23:Int =
      (Sub n.13 Ti1.18)
