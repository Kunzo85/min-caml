(LetRec fib:(Int -> Int) n:Int =
  (Let Ti1:Int =
    1
  In
  (If (LE n Ti1) Then
    n
  Else
    (Let Ti4:Int =
      (Let Ti3:Int =
        (Let Ti2:Int =
          1
        In
        (Sub n Ti2))
      In
      (fib Ti3))
    In
    (Let Ti7:Int =
      (Let Ti6:Int =
        (Let Ti5:Int =
          2
        In
        (Sub n Ti5))
      In
      (fib Ti6))
    In
    (Add Ti4 Ti7)))))
In
(Let Ta8:Array(Int) =
  (Ext_Array io_int)
In
(Let Ti9:Int =
  0
In
(Let Ti11:Int =
  (Let Ti10:Int =
    30
  In
  (fib Ti10))
In
(Ta8.(Ti9) <- Ti11)))))
