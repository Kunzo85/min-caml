(LetRec fib:(Int -> Int) n:Int =
  (Let Ti3:Int =
    1
  In
  (If (LE n Ti3) Then
    n
  Else
    (Let Ti6:Int =
      (Let Ti5:Int =
        (Let Ti4:Int =
          1
        In
        (Sub n Ti4))
      In
      (fib Ti5))
    In
    (Let Ti9:Int =
      (Let Ti8:Int =
        (Let Ti7:Int =
          2
        In
        (Sub n Ti7))
      In
      (fib Ti8))
    In
    (Add Ti6 Ti9)))))
In
(Let Ti2:Int =
  (Let Ti1:Int =
    30
  In
  (fib Ti1))
In
print_int Ti2))
