(LetRec fib:(Int -> Int) n:Int =
  (Let Ti3:Int =
    1 !2
  In
  (If (LE n Ti3) Then
    n !2
  Else
    (Let Ti6:Int =
      (Let Ti5:Int =
        (Let Ti4:Int =
          1 !3
        In
        (Sub n Ti4 !3) !3)
      In
      (fib Ti5 !3) !3)
    In
    (Let Ti9:Int =
      (Let Ti8:Int =
        (Let Ti7:Int =
          2 !3
        In
        (Sub n Ti7 !3) !3)
      In
      (fib Ti8 !3) !3)
    In
    (Add Ti6 Ti9 !3) !3) !3) !2) !2)
In
(Let Ti2:Int =
  (Let Ti1:Int =
    30 !4
  In
  (fib Ti1 !4) !4)
In
print_int Ti2 !4 !4) !1)
