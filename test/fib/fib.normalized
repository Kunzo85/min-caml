(LetRec fib:(Int -> Int) n:Int =
  (Let Ti1:Int =
    1
  In
  (If (LE n Ti1) Then
    n
  Else
    (Let Ti4:Int =
      (Let Ti3:Int =
        (Let Ti2:Int =
          1
        In
        (Sub n Ti2))
      In
      (fib Ti3))
    In
    (Let Ti7:Int =
      (Let Ti6:Int =
        (Let Ti5:Int =
          2
        In
        (Sub n Ti5))
      In
      (fib Ti6))
    In
    (Add Ti4 Ti7)))))
In
(Let Ti9:Int =
  (Let Ti8:Int =
    30
  In
  (fib Ti8))
In
print_int Ti9))
