(LetRec f:(Int -> Unit) n:Int =
  (Let Ti2:Int =
    0
  In
  (If (LE Ti2 n) Then
    (Let Tu1:Unit =
      print_int n
    In
    (Let a:Array((Int -> Unit)) =
      (Let Ti3:Int =
        1
      In
      create_array Ti3 f)
    In
    (Let Tf5:(Int -> Unit) =
      (Let Ti4:Int =
        0
      In
      (a.(Ti4)))
    In
    (Let Ti7:Int =
      (Let Ti6:Int =
        1
      In
      (Sub n Ti6))
    In
    (Tf5 Ti7)))))
  Else
    ()))
In
(Let Ti8:Int =
  9
In
(f Ti8)))
