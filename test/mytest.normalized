(LetRec g:(Int -> Int -> Int -> Int) a:Int b:Int c:Int =
  (Let Ti12:Int =
    (Add a b)
  In
  (Add Ti12 c))
In
(LetRec f:(Int -> Int) n:Int =
  (Let Ti2:Int =
    1
  In
  (If (LE n Ti2) Then
    n
  Else
    (Let Ti8:Int =
      (Let Ti3:Int =
        (Add n n)
      In
      (Let Ti5:Int =
        (Let Ti4:Int =
          1
        In
        (Sub n Ti4))
      In
      (Let Ti7:Int =
        (Let Ti6:Int =
          2
        In
        (Sub n Ti6))
      In
      (g Ti3 Ti5 Ti7))))
    In
    (Let Ti11:Int =
      (Let Ti10:Int =
        (Let Ti9:Int =
          2
        In
        (Sub n Ti9))
      In
      (f Ti10))
    In
    (Add Ti8 Ti11)))))
In
(Let x:Int =
  (Let Ti1:Int =
    10
  In
  (f Ti1))
In
print_int x)))
