(LetRec g:Var(?) a:Var(?) b:Var(?) c:Var(?) =
  (Add
    (Add
      a
      b)
    c)
In
(LetRec f:Var(?) n:Var(?) =
  (If
    (LE
      n
      1)
  Then
    n
  Else
    (Add
      (App
        g
        (Add
          n
          n)
        (Sub
          n
          1)
        (Sub
          n
          2))
      (App
        f
        (Sub
          n
          2))))
In
(Let x:Var(?) =
  (App
    f
    10)
In
(App
  print_int
  x))))
