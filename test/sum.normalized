(LetRec sum:(Int -> Int) x:Int =
  (Let Ti3:Int =
    0
  In
  (If (LE x Ti3) Then
    0
  Else
    (Let Ti6:Int =
      (Let Ti5:Int =
        (Let Ti4:Int =
          1
        In
        (Sub x Ti4))
      In
      (sum Ti5))
    In
    (Add Ti6 x))))
In
(Let Ti2:Int =
  (Let Ti1:Int =
    10000
  In
  (sum Ti1))
In
print_int Ti2))
