In
(LetRec reduce_to_pi:Var(?) x:Var(?) =
  (Let pi:Var(?) =
    3.14159265359
  In
  (Let two_pi:Var(?) =
    (FMul
      2.
      pi)
  In
  (Let r:Var(?) =
    (App
