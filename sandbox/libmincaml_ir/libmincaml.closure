Function fmod.13:(Float -> Float -> Float) Args(x.14:Float y.15:Float) Formal_fv() =
  (Let Td3.25:Float =
    FDiv(x.14, y.15)
  In
  (Let Td4.24:Float =
    Floor(Td3.25)
  In
  (Let Td5.23:Float =
    FMul(Td4.24, y.15)
  In
  FSub(x.14, Td5.23))))

Function reduce_to_pi.16:(Float -> Float) Args(x.17:Float) Formal_fv(pi.10:Float two_pi.11:Float) =
  (Let r.21:Float =
    (AppDir(fmod.13 x.17 two_pi.11))
  In
  (If (LE r.21 pi.10) Then
    (Let Td6.22:Float =
      -3.14159265359
    In
    (If (LE Td6.22 r.21) Then
      r.21
    Else
      FAdd(r.21, two_pi.11)))
  Else
    FSub(r.21, two_pi.11)))

