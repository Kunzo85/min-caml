    (If (LE Td6.22 r.21) Then
      r.21
    Else
      (FAdd r.21 two_pi.11)))
  Else
    (FSub r.21 two_pi.11)))
In
(Let Td9.18:Float =
  (Let Td8.19:Float =
    (Let Td7.20:Float =
      3.
    In
    (FMul Td7.20 pi.10))
  In
  (reduce_to_pi.16 Td8.19))
In
print Td9.18))))))
