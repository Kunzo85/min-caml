(Let pi.10:Float =
  3.14159265359
In
(Let two_pi.11:Float =
  (Let Td1.27:Float =
    2.
  In
  (FMul Td1.27 pi.10))
In
(Let half_pi.12:Float =
  (Let Td2.26:Float =
    0.5
  In
  (FMul Td2.26 pi.10))
In
(LetRec fmod.13:(Float -> Float -> Float) x.14:Float y.15:Float =
  (Let Td5.23:Float =
    (Let Td4.24:Float =
      (Let Td3.25:Float =
        (FDiv x.14 y.15)
      In
      (Floor Td3.25))
    In
    (FMul Td4.24 y.15))
  In
  (FSub x.14 Td5.23))
In
(LetRec reduce_to_pi.16:(Float -> Float) x.17:Float =
  (Let r.21:Float =
    (fmod.13 x.17 two_pi.11)
