(Let pi:Var(?) =
  3.14159265359
In
(Let two_pi:Var(?) =
  (FMul
    2.
    pi)
In
(Let half_pi:Var(?) =
  (FMul
    0.5
    pi)
In
(LetRec fmod:Var(?) x:Var(?) y:Var(?) =
  (FSub
    x
    (FMul
      (Floor
        (FDiv
          x
          y))
      y))
In
(LetRec reduce_to_pi:Var(?) x:Var(?) =
  (Let r:Var(?) =
    (App
      fmod
      x
      two_pi)
  In
  (If
    (Not
      (LE
        r
        pi))
  Then
    (FSub
      r
      two_pi)
  Else
    (If
      (Not
        (LE
          (FNeg
            pi)
          r))
    Then
      (FAdd
        r
        two_pi)
    Else
      r)))
In
(App
  print
  (App
    reduce_to_pi
    (FMul
      3.
      pi))))))))
